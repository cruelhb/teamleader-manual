---
import { formatDate } from '../lib/format';

interface Props {
  url: string;
  title: string;
  summary: string;
  updated: Date | string;
  pinned?: boolean;
}

const { url, title, summary, updated, pinned = false } = Astro.props;
---

<li>
  <a class="card" href={url}>
    {
      pinned && (
        <div class="card__top">
          <span class="badge badge--pinned">중요</span>
        </div>
      )
    }
    <h3 class="card__title">{title}</h3>
    <p class="card__summary">{summary}</p>
    <span class="meta">{formatDate(updated)} 기준</span>
  </a>
</li>
