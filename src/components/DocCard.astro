---
import Icon from './Icon.astro';
import { formatDate } from '../lib/format';
import type { IconName } from '../lib/icons';
import NoticeStatus from './NoticeStatus.astro';
import type { NoticeState } from '../lib/notice';

interface Props {
  url: string;
  title: string;
  summary: string;
  updated: Date | string;
  pinned?: boolean;
  notice?: boolean;
  noticeStatus?: NoticeState;
  endsOn?: string;
  hidden?: boolean;
  /** 카테고리 배지를 보여줄지 (카테고리 목록 안에서는 중복이라 끈다) */
  categoryLabel?: string;
  categoryIcon?: IconName;
}

const { url, title, summary, updated, pinned = false, categoryLabel, categoryIcon, notice, noticeStatus, endsOn, hidden } = Astro.props;
---

<li data-notice-card={notice ? '' : undefined} hidden={hidden}>
  <a class="card" href={url}>
    {
      (pinned || categoryLabel || notice) && (
        <div class="card__top">
          {pinned && <span class="badge badge--pinned">중요</span>}
          {notice && <NoticeStatus noticeStatus={noticeStatus} endsOn={endsOn} />}
          {categoryLabel && (
            <span class="badge">
              {categoryIcon && <Icon name={categoryIcon} size={14} />}
              {categoryLabel}
            </span>
          )}
        </div>
      )
    }
    <h3 class="card__title">{title}</h3>
    <p class="card__summary">{summary}</p>
    <span class="meta">{formatDate(updated)} 기준</span>
  </a>
</li>
