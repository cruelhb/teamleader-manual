---
import Icon from './Icon.astro';
---

<div class="search" data-search>
  <label class="sr-only" for="site-search">검색어를 입력하세요</label>

  <div class="search__field">
    <span class="search__icon"><Icon name="search" size={20} /></span>
    <input
      class="search__input"
      id="site-search"
      type="search"
      inputmode="search"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="search"
      placeholder="무엇이 궁금하세요? (예: 연차, ㄱㅈㅎㄱ)"
      data-search-input
    />
    <button class="search__clear" type="button" aria-label="검색어 지우기" data-search-clear>
      ✕
    </button>
  </div>

  <p class="search__hint" data-search-hint>
    초성으로도 찾을 수 있어요 — <strong>ㅇㅊ</strong> → 연차, <strong>ㄱㅈㅎㄱ</strong> → 경조휴가
  </p>

  <p class="search__count" hidden data-search-count></p>

  <ul class="search__results" data-search-results></ul>

  <div class="search__noresult" hidden data-search-noresult>
    <p><strong data-search-term></strong> 에 대한 결과가 없어요.</p>
    <p>다른 단어로 검색해 보시거나, 검색어를 지우고 아래 메뉴에서 찾아보세요.</p>
  </div>
</div>

<script>
  import { searchDocs, type SearchDoc } from '../lib/search';
  import { formatDate } from '../lib/format';
  import { iconSvg } from '../lib/icons';

  const root = document.querySelector<HTMLElement>('[data-search]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]')!;
    const clearButton = root.querySelector<HTMLButtonElement>('[data-search-clear]')!;
    const resultList = root.querySelector<HTMLUListElement>('[data-search-results]')!;
    const countLine = root.querySelector<HTMLElement>('[data-search-count]')!;
    const hint = root.querySelector<HTMLElement>('[data-search-hint]')!;
    const noResult = root.querySelector<HTMLElement>('[data-search-noresult]')!;
    const noResultTerm = root.querySelector<HTMLElement>('[data-search-term]')!;

    // 홈에서 검색 중일 때는 아래 영역(바로가기·최신 공지)을 숨긴다.
    const homeBody = document.querySelector<HTMLElement>('[data-home-body]');

    let docs: SearchDoc[] | null = null;
    let loading: Promise<void> | null = null;
    let activeIndex = -1;

    const escapeHtml = (value: string) =>
      value.replace(
        /[&<>"']/g,
        (char) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]!,
      );

    const loadIndex = () => {
      if (!loading) {
        loading = fetch('/search-index.json')
          .then((response) => response.json())
          .then((data: SearchDoc[]) => {
            docs = data;
          })
          .catch(() => {
            docs = [];
          });
      }
      return loading;
    };

    // 검색창에 손이 닿는 순간 인덱스를 미리 받아둔다.
    input.addEventListener('focus', loadIndex, { once: true });
    input.addEventListener('input', loadIndex, { once: true });

    const setActive = (next: number) => {
      const items = resultList.querySelectorAll<HTMLLIElement>('.search__result');
      if (items.length === 0) return;

      activeIndex = ((next % items.length) + items.length) % items.length;
      items.forEach((item, index) => {
        item.classList.toggle('is-active', index === activeIndex);
      });
      items[activeIndex].scrollIntoView({ block: 'nearest' });
    };

    const renderResults = (query: string) => {
      if (!docs) return;

      const results = searchDocs(docs, query, 20);
      activeIndex = -1;

      resultList.innerHTML = results
        .map(({ doc }) => {
          return `
            <li class="search__result">
              <a class="card" href="${escapeHtml(doc.url)}">
                <div class="card__top">
                  <span class="badge">
                    ${iconSvg(doc.categoryIcon, 14)}
                    ${escapeHtml(doc.categoryLabel)}
                  </span>
                </div>
                <h3 class="card__title">${escapeHtml(doc.title)}</h3>
                <p class="card__summary">${escapeHtml(doc.summary)}</p>
                <span class="meta">${escapeHtml(formatDate(doc.updated))} 기준</span>
              </a>
            </li>`;
        })
        .join('');

      const hasResults = results.length > 0;
      countLine.hidden = !hasResults;
      countLine.textContent = hasResults ? `검색 결과 ${results.length}건` : '';

      noResult.hidden = hasResults;
      noResultTerm.textContent = query;
    };

    const reset = () => {
      resultList.innerHTML = '';
      countLine.hidden = true;
      noResult.hidden = true;
      hint.hidden = false;
      activeIndex = -1;
      if (homeBody) homeBody.hidden = false;
    };

    let debounce = 0;
    input.addEventListener('input', () => {
      const query = input.value.trim();
      clearButton.classList.toggle('is-visible', query.length > 0);

      window.clearTimeout(debounce);

      if (!query) {
        reset();
        return;
      }

      hint.hidden = true;
      if (homeBody) homeBody.hidden = true;

      debounce = window.setTimeout(() => {
        void loadIndex().then(() => renderResults(query));
      }, 80);
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        input.value = '';
        clearButton.classList.remove('is-visible');
        reset();
        return;
      }

      if (event.key === 'ArrowDown') {
        event.preventDefault();
        setActive(activeIndex + 1);
        return;
      }

      if (event.key === 'ArrowUp') {
        event.preventDefault();
        setActive(activeIndex - 1);
        return;
      }

      if (event.key === 'Enter') {
        const items = resultList.querySelectorAll<HTMLLIElement>('.search__result a');
        const target = activeIndex >= 0 ? items[activeIndex] : items[0];
        if (target instanceof HTMLAnchorElement) {
          event.preventDefault();
          window.location.href = target.href;
        }
      }
    });

    clearButton.addEventListener('click', () => {
      input.value = '';
      clearButton.classList.remove('is-visible');
      reset();
      input.focus();
    });
  }
</script>
