---
import '../styles/global.css';
import site from '../data/site.json';
import Icon from '../components/Icon.astro';
import SearchBox from '../components/SearchBox.astro';
import DocNavigation from '../components/DocNavigation.astro';

interface Props {
  /** 브라우저 탭 / 카카오톡 미리보기 제목. 없으면 사이트 이름만 쓴다. */
  title?: string;
  /** 카카오톡 미리보기 설명 */
  description?: string;
  /** og:type — 문서 페이지는 'article' */
  ogType?: 'website' | 'article';
}

const { title, description = site.description, ogType = 'website' } = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} — ${site.tagline}`;

// 카카오톡 링크 미리보기는 절대 URL만 인식한다. astro.config.mjs 의 site 값을 기준으로 만든다.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site);

// 파비콘. 이미지 파일 없이 SVG 를 그대로 주소에 담는다.
// 헤더 로고와 같은 "겹친 마름모"(src/lib/icons.ts 의 logo)를 브랜드색 사각형 위에 올린 것.
// 작은 크기에서도 알아보이게 선 대신 면으로 채웠다. '#' 은 주소에서 %23 으로 써야 한다.
const favicon =
  "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'>" +
  "<rect width='100' height='100' rx='22' fill='%231f5fa9'/>" +
  "<path d='M50 21 79 50 50 79 21 50Z' fill='none' stroke='white' stroke-width='7'/>" +
  "<path d='M50 39 61 50 50 61 39 50Z' fill='white'/></svg>";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="only light" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={favicon} />

    {/* 사내 안내용 사이트 — 검색엔진에 노출되지 않게 한다 */}
    <meta name="robots" content="noindex, nofollow, noarchive" />

    {/* 카카오톡·슬랙 등 링크 미리보기용 */}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:locale" content="ko_KR" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#1f5fa9" />

    {/* 페이지별로 <head> 에 더 넣을 것이 있으면 slot="head" 로 넘긴다
        (문서 페이지가 본문 아이콘 CSS 를 이렇게 넣는다) */}
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main-content">본문 바로가기</a>
    <header class="site-header">
      <div class="site-header__bar">
        {/* 헤더는 좁은 폰 화면을 고려해 짧은 이름을 쓴다 (전체 이름은 제목·미리보기에 사용) */}
        <a class="site-header__logo" href="/">
          <Icon name="logo" size={19} />
          {site.shortName}
        </a>
        <SearchBox />
        <span class="site-header__note">서면심사본부</span>
      </div>
    </header>

    <div class="docs-shell">
      <aside class="docs-sidebar"><DocNavigation /></aside>
      <div class="docs-content">
        <main id="main-content" tabindex="-1">
          <slot />
        </main>
        <footer class="site-footer">
          <p>{site.footerNote}</p>
        </footer>
      </div>
    </div>
  </body>
</html>
