---
import BaseLayout from './BaseLayout.astro';
import ShareButton from '../components/ShareButton.astro';
import Icon from '../components/Icon.astro';
import { formatDate } from '../lib/format';
import { bodyIconCss, type IconName } from '../lib/icons';
import DocTools from '../components/DocTools.astro';

interface Props {
  title: string;
  summary: string;
  updated: Date | string;
  source?: string;
  file?: string;
  quickSummary?: { audience?: string; keyPoint?: string; action?: string } | null;
  relatedDocs?: Array<{ url: string; title: string; summary: string }>;
  /** 제목 왼쪽 아이콘. 홈 카드와 같은 것 */
  icon?: IconName;
}

const { title, summary, updated, source, file, quickSummary, relatedDocs = [], icon = 'guide' } = Astro.props;
const summaryRows = [
  ['대상', quickSummary?.audience], ['핵심 기준', quickSummary?.keyPoint], ['처리 방법', quickSummary?.action],
].filter(([, value]) => value);

// 본문에서 <i class="ico ico--이름"></i> 로 쓰는 아이콘의 모양 정의.
// 문서 페이지에서만 필요하므로 여기서만 심는다.
const iconCss = bodyIconCss();
---

<BaseLayout title={title} description={summary} ogType="article">
  <style slot="head" is:inline set:html={iconCss}></style>

  <article class="doc">
    <p class="doc__breadcrumb">
      <a class="back-link" href="/">
        <Icon name="arrowLeft" size={17} />
        홈으로
      </a>
    </p>

    {/* 제목 · 핵심 요약 · 목차 · 본문 · 관련 문서를 각각 둥근 카드로 쌓는다 */}
    <header class="doc-panel">
      <div class="doc__heading">
        <span class="doc__icon"><Icon name={icon} size={24} /></span>
        <h1 class="doc__title">{title}</h1>
      </div>
      <div class="doc__meta">
        <span><strong>최종 수정일</strong>{formatDate(updated)}</span>
        {source && <span><strong>근거</strong>{source}</span>}
      </div>
    </header>

    {summaryRows.length > 0 && <section class="quick-summary" aria-labelledby="quick-summary-title">
      <h2 id="quick-summary-title">핵심 요약</h2>
      <dl>{summaryRows.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
    </section>}
    <DocTools />

    <div class="doc-panel">
      {
        file && (
          <p>
            <a class="btn btn--primary" href={file} download>
              <Icon name="download" size={18} /> 서식 내려받기
            </a>
          </p>
        )
      }

      <div class="prose" data-prose>
        <slot />
      </div>

      <ShareButton />
    </div>

    {relatedDocs.length > 0 && <section class="doc-panel related-docs" aria-labelledby="related-docs-title">
      <h2 id="related-docs-title">함께 보면 좋은 문서</h2>
      <ul>{relatedDocs.map((doc) => <li><a href={doc.url}><strong>{doc.title}</strong><span>{doc.summary}</span></a></li>)}</ul>
    </section>}
  </article>
</BaseLayout>

<script>
  import { iconSvg } from '../lib/icons';
  // 1) 표를 감싸고, 각 칸에 머리글 이름을 data-label 로 붙인다.
  //    넓은 화면에서는 표로, 좁은 화면(700px 이하)에서는
  //    CSS가 이 라벨을 이용해 표를 카드 형태로 바꾼다.
  document.querySelectorAll<HTMLTableElement>('[data-prose] table').forEach((table) => {
    if (!table.parentElement?.classList.contains('table-scroll')) {
      const scroller = document.createElement('div');
      scroller.className = 'table-scroll';
      table.replaceWith(scroller);
      scroller.appendChild(table);
    }

    const headers = [...table.querySelectorAll('thead th')].map((th) => th.textContent?.trim() ?? '');
    if (headers.length === 0) return;

    table.querySelectorAll('tbody tr').forEach((row) => {
      [...row.cells].forEach((cell, index) => {
        if (headers[index]) cell.setAttribute('data-label', headers[index]);
      });
    });
  });

  // 2) 접었다 펴는 목록이 여러 개면 "모두 펼치기" 버튼을 붙인다.
  //    규정 전체를 한 번에 훑거나 Ctrl+F 로 찾을 때 필요하다.
  const sections = [...document.querySelectorAll<HTMLDetailsElement>('[data-prose] details')];

  if (sections.length > 1) {
    const toggle = document.createElement('button');
    toggle.type = 'button';
    toggle.className = 'details-toggle';
    toggle.textContent = '모두 펼치기';

    toggle.addEventListener('click', () => {
      const shouldOpen = sections.some((section) => !section.open);
      sections.forEach((section) => {
        section.open = shouldOpen;
      });
      toggle.textContent = shouldOpen ? '모두 접기' : '모두 펼치기';
    });

    // 사용자가 개별로 여닫으면 버튼 문구도 따라간다.
    sections.forEach((section) => {
      section.addEventListener('toggle', () => {
        toggle.textContent = sections.every((item) => item.open) ? '모두 접기' : '모두 펼치기';
      });
    });

    sections[0].parentElement?.insertBefore(toggle, sections[0]);
  }

  // 3) 스크린샷을 탭하면 전체 화면으로 확대한다.
  //    폰에서 캡처 속 작은 글씨를 읽으려면 이게 없으면 답이 없다.
  const lightbox = document.createElement('div');
  lightbox.className = 'lightbox';
  lightbox.hidden = true;
  lightbox.innerHTML =
    `<button class="lightbox__close" type="button" aria-label="닫기">${iconSvg('close', 22)}</button><img alt="" />`;
  document.body.appendChild(lightbox);

  const lightboxImage = lightbox.querySelector('img')!;

  const closeLightbox = () => {
    lightbox.hidden = true;
    lightboxImage.removeAttribute('src');
    document.body.style.overflow = '';
  };

  document.querySelectorAll<HTMLImageElement>('[data-prose] img').forEach((image) => {
    image.style.cursor = 'zoom-in';
    image.addEventListener('click', () => {
      lightboxImage.src = image.currentSrc || image.src;
      lightboxImage.alt = image.alt;
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
    });
  });

  lightbox.addEventListener('click', closeLightbox);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !lightbox.hidden) closeLightbox();
  });
</script>
