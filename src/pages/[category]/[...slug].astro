---
import { getCollection, render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import { CATEGORY_ORDER } from '../../lib/categories';

export async function getStaticPaths() {
  const paths = [];

  for (const category of CATEGORY_ORDER) {
    const entries = await getCollection(category);
    for (const entry of entries) {
      paths.push({
        params: { category, slug: entry.id },
        props: { entry, category },
      });
    }
  }

  return paths;
}

const { entry, category } = Astro.props;
const { Content } = await render(entry);
const allDocs = (await Promise.all(CATEGORY_ORDER.map(async (key) =>
  (await getCollection(key)).map((doc) => ({ url: `/${key}/${doc.id}/`, title: doc.data.title, summary: doc.data.summary }))
))).flat();
const relatedDocs = [...new Set(entry.data.relatedDocs as string[])].map((url) => {
  const doc = allDocs.find((item) => item.url === decodeURI(url));
  if (!doc) throw new Error(`관련 문서를 찾을 수 없습니다: ${entry.id} → ${url}`);
  return doc;
}).filter((doc) => doc.url !== `/${category}/${entry.id}/`);
---

<DocLayout
  category={category}
  title={entry.data.title}
  summary={entry.data.summary}
  updated={entry.data.updated}
  source={entry.data.source}
  file={entry.data.file}
  quickSummary={entry.data.quickSummary}
  relatedDocs={relatedDocs}
  noticeStatus={entry.data.noticeStatus}
  endsOn={entry.data.endsOn}
>
  <Content />
</DocLayout>
