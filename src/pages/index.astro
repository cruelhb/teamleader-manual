---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DocCard from '../components/DocCard.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import shortcuts from '../data/shortcuts.json';
import { CATEGORIES } from '../lib/categories';
import type { IconName } from '../lib/icons';
import { sortDocs } from '../lib/docs';
import { noticeState } from '../lib/notice';

const notices = sortDocs(await getCollection('notice'), CATEGORIES.notice.sort);
const visibleNotices = new Set(notices.filter((item) => noticeState(item.data) === 'active').slice(0, 3).map((item) => item.id));
---

<BaseLayout>
  <section class="hero">
    <p class="hero__eyebrow">서면심사본부 · 업무 가이드</p>
    <h1 class="hero__title">{site.name}</h1>
    <p class="hero__tagline">{site.tagline}</p>
    <p class="hero__description">궁금한 내용을 검색하거나 문서 메뉴에서 찾아보세요.<br />필요한 안내는 링크 하나로 함께 나눌 수 있습니다.</p>
  </section>

  <div>
    <section class="section">
      <h2 class="section__title">자주 찾는 항목</h2>
      <ul class="shortcut-grid">
        {
          shortcuts.map((shortcut) => (
            <li>
              <a class="shortcut" href={shortcut.url}>
                <span class="shortcut__icon">
                  <Icon name={shortcut.icon as IconName} size={22} />
                </span>
                {shortcut.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" data-home-notices>
      <h2 class="section__title">
        최신 공지
        <a class="section__more" href="/notice/">전체 보기 <Icon name="arrowRight" size={15} /></a>
      </h2>

      {
        notices.length > 0 ? (
          <ul class="card-list">
            {notices.map((notice) => (
              <DocCard
                url={`/notice/${notice.id}/`}
                title={notice.data.title}
                summary={notice.data.summary}
                updated={notice.data.updated}
                pinned={notice.data.pinned}
                notice
                noticeStatus={notice.data.noticeStatus}
                endsOn={notice.data.endsOn}
                hidden={!visibleNotices.has(notice.id)}
              />
            ))}
          </ul>
        ) : null
      }
      <p class="empty" data-notices-empty hidden={visibleNotices.size > 0}>현재 진행 중인 공지가 없습니다. 이전 공지는 전체 보기에서 확인하세요.</p>
    </section>
  </div>
</BaseLayout>
